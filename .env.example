# Which bundled services docker-compose.yml starts. Remove "db" and/or
# "qdrant" here (or run `docker compose --profile qdrant up`, etc., to
# override just for one command) to skip the bundled container and use an
# external instance instead — set DATABASE_URL / QDRANT_URL below to point
# at it. Prefer `scripts/setup.sh` (or `scripts/setup.ps1` on Windows) over
# editing this by hand — it asks the same question interactively and keeps
# this in sync with DATABASE_URL/QDRANT_URL for you.
COMPOSE_PROFILES=db,qdrant

POSTGRES_DB=novel
POSTGRES_USER=novel
POSTGRES_PASSWORD=novel
ADMIN_PASSWORD=novel
# Optional: "Googleでログイン" / "GitHubでログイン" on the login screen. A
# provider only appears once BOTH its client_id and secret below are set —
# leave both blank to keep username/password as the only way to sign in.
# Get these from Google Cloud Console / a GitHub OAuth App; the "Authorized
# redirect URI" you register there must be exactly
# <OAUTH_REDIRECT_BASE_URL>/auth/callback/google (or /github) — see that
# variable below. SESSION_SECRET signs the resulting login cookie; change
# it from the placeholder before exposing this beyond your own machine,
# the same as ADMIN_PASSWORD.
SESSION_SECRET=change-me-session-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The externally-reachable *API* address — what Google/GitHub redirect back
# to after consent, not what the browser opens (that's NEXT_PUBLIC_API_URL,
# same idea). Change alongside NEXT_PUBLIC_API_URL for anything other than
# localhost. OAUTH_LOGIN_REDIRECT_URL is the web app's own address, where
# the browser ends up after a successful login.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
OAUTH_LOGIN_REDIRECT_URL=http://localhost:3000
# Only read when the "db" / "qdrant" profiles above are NOT active — the
# bundled containers ignore these and always use their own fixed
# db:5432 / qdrant:6333 addresses on the Compose network.
DATABASE_URL=postgresql+psycopg2://novel:novel@db:5432/novel
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Auto-write's Controller (planning/quality-gate) model. Can point at the
# same Ollama server as OLLAMA_URL with a different model, or at a second
# Ollama server entirely (e.g. a separate GPU).
CONTROLLER_OLLAMA_URL=http://host.docker.internal:11434
CONTROLLER_OLLAMA_MODEL=qwen3:14b
# Optional: sent as "Authorization: Bearer <key>" on every request to the
# respective Ollama server. A bare local `ollama serve` has no auth, so
# both are blank by default — set one only if that Ollama sits behind
# something that does check one (a gated reverse proxy, a hosted/cloud
# Ollama offering, an OpenAI-API-compatible gateway). Independent of each
# other since Writer and Controller are typically separate instances.
OLLAMA_API_KEY=
CONTROLLER_OLLAMA_API_KEY=
# Comma-separated list of origins allowed to call the API from a browser
# (the web app's own origin, plus any other host you access it from — e.g.
# a LAN IP or a custom domain). Previously hardcoded to localhost:3000 in
# docker-compose.yml regardless of this value; now actually respected.
CORS_ORIGINS=*
# The URL your browser uses to reach the API — baked into the web app's
# JavaScript at build time. If you access the web app from anywhere other
# than the Docker host itself (a LAN IP, a cloud VM's public address, a
# domain), this MUST be that address's :8000/api/v1, not localhost —
# "localhost" in the browser always means the visitor's own computer.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional: episode text is always mirrored to disk (NOVEL_STORAGE_DIR,
# defaults to a container-local volume). Set GIT_REMOTE_URL to also
# auto-commit and push that mirror to a git remote on a timer. Embed your
# token in the URL the way git expects it, e.g.:
#   https://<personal-access-token>@github.com/<you>/<repo>.git
# Leave unset to keep the local-disk mirror without any GitHub sync.
GIT_REMOTE_URL=
GIT_AUTOSYNC_INTERVAL_SECONDS=300
# Optional: scheduled backups (PostgreSQL dump + Qdrant snapshot) on a
# timer, written to a container volume (BACKUP_DIR). Off by default — set
# BACKUP_ENABLED=true to turn it on. You can also trigger one on demand
# any time from 設定 > バックアップ, or run scripts/backup.sh by hand.
BACKUP_ENABLED=false
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=7
# Optional: password-reset emails (the "パスワードをお忘れですか？" link on the
# login screen). SMTP_HOST empty (the default) means no mail server is
# configured — the reset link is only written to the API's log instead of
# actually emailed, which is fine for local/dev use but not for anyone else
# to receive it. Only matters for accounts that have an email address set —
# either via Google/GitHub login (see OAuth2 settings above), or an email
# entered when an admin adds the account under アカウント設定 > ユーザー管理.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

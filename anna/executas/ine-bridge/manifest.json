                                             "type":  "string",
                                             "description":  "Art style hint: anime, realistic, watercolor, ...",
                                             "required":  false
                                         }
                                     ]
                  },
                  {
                      "name":  "proofread_episode",
                      "description":  "Proofread an episode using the project's style guide and Anna's LLM via reverse RPC sampling. Returns suggested corrections (original, suggested, reason). With apply=true, saves all corrections back to the episode. Requires a style guide to be set on the project. Requires sampling context.",
                      "parameters":  [
                                         {
                                             "name":  "episode_id",
                                             "type":  "integer",
                                             "description":  "INE episode id",
                                             "required":  true
                                         },
                                         {
                                             "name":  "apply",
                                             "type":  "boolean",
                                             "description":  "If true, save all corrections back to the episode (default false)",
                                             "required":  false
                                         }
                                     ]
                  }

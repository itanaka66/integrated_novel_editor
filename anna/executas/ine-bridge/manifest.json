                  {
                      "name":  "reflect_to_novel",
                      "description":  "Re-sync entity data back into the novel. For characters: re-runs character-state extraction on the 3 most recent episodes. For plots / foreshadowings: re-runs the continuity checker. Use after manually editing characters, plots, or foreshadowings to keep the Story Twin consistent.",
                      "parameters":  [
                                         {
                                             "name":  "project_id",
                                             "type":  "integer",
                                             "description":  "INE project id",
                                             "required":  true
                                         },
                                         {
                                             "name":  "kind",
                                             "type":  "string",
                                             "description":  "characters | plots | foreshadowings | all (default all)",
                                             "required":  false
                                         }
                                     ]
                  },
                  {
                      "name":  "generate_cover_prompt",
                      "description":  "Generate an English text-to-image prompt for a novel cover illustration using Anna's LLM. Draws on the project synopsis, genre, recent episodes and characters. Returns a ready-to-use prompt string. Requires sampling context.",
                      "parameters":  [
                                         {
                                             "name":  "project_id",
                                             "type":  "integer",
                                             "description":  "INE project id",
                                             "required":  true
                                         },
                                         {

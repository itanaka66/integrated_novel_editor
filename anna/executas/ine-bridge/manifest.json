{
    "version":  "0.2.12",
    "display_name":  "INE Bridge",
    "description":  "Connect Anna to a running Integrated Novel Editor (INE) instance. Uses Anna\u0027s own LLM for prose generation and chat. List works, read the story twin, search episodes, manage plots and foreshadowings, reflect entities to novel, and manage auto-write jobs.",
    "host_capabilities":  [
                              "llm.sample"
                          ],
    "credentials":  [
                        {
                            "name":  "INE_BASE_URL",
                            "display_name":  "INE API base URL",
                            "description":  "Origin of the INE API, without a trailing slash. Default http://localhost:8000",
                            "required":  false,
                            "sensitive":  false,
                            "default":  "http://localhost:8000"
                        },
                        {
                            "name":  "INE_USERNAME",
                            "display_name":  "INE username",
                            "description":  "HTTP Basic username for the INE API (same as the web login).",
                            "required":  true,
                            "sensitive":  false
                        },
                        {
                            "name":  "INE_PASSWORD",
                            "display_name":  "INE password",
                            "description":  "HTTP Basic password for the INE API.",
                            "required":  true,
                            "sensitive":  true
                        }
                    ],
    "runtime":  {
                    "type":  "uv",
                    "min_version":  "0.1.0"
                },
    "tools":  [
                  {
                      "name":  "health",
                      "description":  "Ping the INE API. Auth is optional for this call.",
                      "parameters":  [

                                     ]
                  },

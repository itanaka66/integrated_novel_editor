                          ],
    "optional_executas":  [

                          ],
    "system_prompt_addendum":  "The user has the Integrated Novel Editor app open. Treat the ine-bridge Executa as the source of truth for every work, episode, character, and continuity issue. Call health then list_projects before assuming a project_id. Prefer generate (INE context builder) over freehand prose. Never overwrite episode content unless the user clearly asked to save. Follow the Novel Coach skill for tone and tool order.",
    "user_message_prefix_template":  "[INE] {user_message}",

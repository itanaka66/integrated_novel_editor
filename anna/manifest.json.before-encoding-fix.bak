{
    "schema":  3,
    "required_executas":  [
                              {
                                  "tool_id":  "bundled:ine-bridge",
                                  "min_version":  "0.1.0",
                                  "version":  "latest"
                              }
                          ],
    "optional_executas":  [

                          ],
    "system_prompt_addendum":  "You are INE's AI writing assistant. Use ine-bridge as the source of truth; never invent story data, IDs, or episode numbers.　　Before working, call health and list_projects. Ask the user to choose if multiple projects exist. Use get_story_twin to review story health, active plots, and open foreshadowings when relevant.　　Prefer INE's generate tool to preserve story context. Read episodes before continuing them. Never overwrite content or save drafts without authorization. Confirm episode number and title before creating new episodes.　　Use INE tools for story entities and call reflect_to_novel after manual edits when appropriate. Report continuity issues without silently changing established facts. Report errors honestly; never claim uncompleted actions succeeded.　　Match the novel's language. Respond in Japanese for Japanese works unless requested otherwise.",
    "user_message_prefix_template":  "[INE] {user_message}",
    "tags":  [
                 "writing",
                 "novel",
                 "continuity",
                 "ine"
             ],
    "ui":  {
               "bundle":  {
                              "format":  "static-spa",
                              "entry":  "index.html",
                              "external_origins":  [
                                                       "http://localhost:3000"
                                                   ]
                          },
               "views":  [
                             {
                                 "name":  "main",
                                 "title":  "INE",
                                 "default":  true,
                                 "entry":  "index.html",
                                 "min_size":  {
                                                  "w":  900,
                                                  "h":  600
                                              },
                                 "default_size":  {
                                                      "w":  1300,
                                                      "h":  800
                                                  },
                                 "max_size":  {
                                                  "w":  1600,
                                                  "h":  1200
                                              },
                                 "resizable":  true,
                                 "movable":  true,
                                 "single_instance":  true,
                                 "icon":  "icon.svg"
                             }
                         ],
               "host_api":  {
                                "tools":  [
                                              "required:*"
                                          ],
                                "chat":  [
                                             "write_message"
                                         ],
                                "artifact":  [

                                             ],
                                "llm":  [

                                        ],
                                "fs":  [

                                       ],
                                "storage":  [
                                                "get",
                                                "set"
                                            ],
                                "prefs":  [

                                          ],
                                "window":  [
                                               "set_title"
                                           ]
                            },
               "csp_overrides":  {
                                     "img-src":  [
                                                     "\u0027self\u0027",
                                                     "data:",
                                                     "blob:"
                                                 ],
                                     "font-src":  [
                                                      "\u0027self\u0027",
                                                      "data:"
                                                  ],
                                     "style-src":  [
                                                       "\u0027self\u0027"
                                                   ],
                                     "script-src":  [
                                                        "\u0027self\u0027"
                                                    ],
                                     "frame-src":  [
                                                       "\u0027self\u0027",
                                                       "http://localhost:3000"
                                                   ]
                                 },
               "state_merge":  "last_writer_wins"
           },

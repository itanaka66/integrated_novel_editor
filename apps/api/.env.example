# Copy this to apps/api/.env and edit — only used when running the API
# natively (`uvicorn app.main:app ...` from this directory). This is
# separate from the repo-root .env docker-compose reads; the two are never
# mixed together. Real OS/shell environment variables always take priority
# over this file, so `export DATABASE_URL=...` still works if you prefer
# that instead. See ../../docs/requirements.md for the full variable list.

DATABASE_URL=postgresql+psycopg2://novel:novel@localhost:5432/novel
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_EMBED_MODEL=nomic-embed-text
CONTROLLER_OLLAMA_URL=http://localhost:11434
CONTROLLER_OLLAMA_MODEL=qwen3:14b
CORS_ORIGINS=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

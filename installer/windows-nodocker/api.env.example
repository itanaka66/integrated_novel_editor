# Copied to .env next to ine-api.exe on first launch (see launch.ps1),
# which fills in ADMIN_PASSWORD with a random value and shows it once.
#
# Unlike the Docker-based installer (installer/windows), everything here
# runs as plain Windows processes: SQLite instead of PostgreSQL (a single
# file under .\data\), and a bundled qdrant.exe instead of a container.
# See ../../docs/requirements.md for what each variable does; only the
# ones relevant to this no-Docker setup are listed below.
DATABASE_URL=sqlite:///./data/ine.db
QDRANT_URL=http://127.0.0.1:6333
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
CONTROLLER_OLLAMA_URL=http://localhost:11434
CONTROLLER_OLLAMA_MODEL=qwen3:14b
CORS_ORIGINS=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
NOVEL_STORAGE_DIR=./data/novel_storage
